        "sdk/esp32c6/include/espressif__esp-dsp/modules/windows/include",
        "sdk/esp32c6/include/espressif__esp-dsp/modules/windows/hann/include",
        "sdk/esp32c6/include/espressif__esp-dsp/modules/windows/blackman/include",
        "sdk/esp32c6/include/espressif__esp-dsp/modules/windows/blackman_harris/include",
        "sdk/esp32c6/include/espressif__esp-dsp/modules/windows/blackman_nuttall/include",
        "sdk/esp32c6/include/espressif__esp-dsp/modules/windows/nuttall/include",
        "sdk/esp32c6/include/espressif__esp-dsp/modules/windows/flat_top/include",
        "sdk/esp32c6/include/espressif__esp-dsp/modules/iir/include",
        "sdk/esp32c6/include/espressif__esp-dsp/modules/fir/include",
        "sdk/esp32c6/include/espressif__esp-dsp/modules/math/include",
        "sdk/esp32c6/include/espressif__esp-dsp/modules/math/add/include",
        "sdk/esp32c6/include/espressif__esp-dsp/modules/math/sub/include",
        "sdk/esp32c6/include/espressif__esp-dsp/modules/math/mul/include",
        "sdk/esp32c6/include/espressif__esp-dsp/modules/math/addc/include",
        "sdk/esp32c6/include/espressif__esp-dsp/modules/math/mulc/include",
        "sdk/esp32c6/include/espressif__esp-dsp/modules/math/sqrt/include",
        "sdk/esp32c6/include/espressif__esp-dsp/modules/matrix/mul/include",
        "sdk/esp32c6/include/espressif__esp-dsp/modules/matrix/add/include",
        "sdk/esp32c6/include/espressif__esp-dsp/modules/matrix/addc/include",
        "sdk/esp32c6/include/espressif__esp-dsp/modules/matrix/mulc/include",
        "sdk/esp32c6/include/espressif__esp-dsp/modules/matrix/sub/include",
        "sdk/esp32c6/include/espressif__esp-dsp/modules/matrix/include",
        "sdk/esp32c6/include/espressif__esp-dsp/modules/fft/include",
        "sdk/esp32c6/include/espressif__esp-dsp/modules/dct/include",
        "sdk/esp32c6/include/espressif__esp-dsp/modules/conv/include",
        "sdk/esp32c6/include/espressif__esp-dsp/modules/common/include",
        "sdk/esp32c6/include/espressif__esp-dsp/modules/matrix/mul/test/include",
        "sdk/esp32c6/include/espressif__esp-dsp/modules/kalman/ekf/include",
        "sdk/esp32c6/include/espressif__esp-dsp/modules/kalman/ekf_imu13states/include",
        "sdk/esp32c6/include/espressif__esp_modem/include",
        "sdk/esp32c6/include/espressif__esp_modem/command/include",
        "sdk/esp32c6/include/espressif__esp_schedule/include",
        "sdk/esp32c6/include/espressif__network_provisioning/include",
        "sdk/esp32c6/include/espressif__esp_rainmaker/include",
        "sdk/esp32c6/include/espressif__qrcode/include",
        "sdk/esp32c6/include/joltwallet__littlefs/include",
        "sdk/esp32c6/include/fb_gfx/include",
        "sdk/esp32c6/qio_qspi/include",
        "cores/esp32",
        "variants/esp32c6",
        "libraries/SPI/src",  # FastLED's ESP32 SPI shim includes <SPI.h>
    ],
    defines = [
        "ESP32_ARDUINO_LIB_BUILDER",
        "ESP_PLATFORM",
        "MB_MDNS_IS_INCLUDED",
        "MD5_ENABLED=1",
        "OPENTHREAD_FTD=1",
        "SERIAL_FLASHER_BOOT_HOLD_TIME_MS=50",
        "SERIAL_FLASHER_RESET_HOLD_TIME_MS=100",
        "SOC_MMU_PAGE_SIZE=CONFIG_MMU_PAGE_SIZE",
        "SOC_XTAL_FREQ_MHZ=CONFIG_XTAL_FREQ",
        "UNITY_INCLUDE_CONFIG_H",
        "_GLIBCXX_HAVE_POSIX_SEMAPHORE",
        "_GLIBCXX_USE_POSIX_SEMAPHORE",
        "_GNU_SOURCE",
        "_POSIX_READER_WRITER_LOCKS",
        "TF_LITE_STATIC_MEMORY",
        "CHIP_CONFIG_SOFTWARE_VERSION_NUMBER=0",
        "CHIP_DNSSD_DEFAULT_PLATFORM=true",
        "CHIP_DNSSD_DEFAULT_NONE=false",
        "CHIP_DNSSD_DEFAULT_MINIMAL=false",
        "F_CPU=160000000L",
        "ARDUINO=10812",
        "ARDUINO_ESP32C6_DEV",
        "ARDUINO_ARCH_ESP32",
        "ARDUINO_PARTITION_default",
        'ARDUINO_BOARD=\\"ESP32C6_DEV\\"',
        'ARDUINO_VARIANT=\\"esp32c6\\"',
        # From platform.txt build.extra_flags — ESP32=ESP32 is what libraries
        # (e.g. FastLED) key off for platform detection.
        "ESP32=ESP32",
        "CORE_DEBUG_LEVEL=0",
        "ARDUINO_USB_MODE=1",
        "ARDUINO_USB_CDC_ON_BOOT=1",
    ],
)

_C_COPTS = [
        "-march=rv32imac_zicsr_zifencei",
        "-ffunction-sections",
        "-fdata-sections",
        "-Wno-error=unused-function",
        "-Wno-error=unused-variable",
        "-Wno-error=unused-but-set-variable",
        "-Wno-error=deprecated-declarations",
        "-Wno-error=extra",
        "-Wno-unused-parameter",
        "-Wno-sign-compare",
        "-Wno-enum-conversion",
        "-gdwarf-4",
        "-ggdb",
        "-freorder-blocks",
        "-Wwrite-strings",
        "-fstack-protector",
        "-fstrict-volatile-bitfields",
        "-fno-jump-tables",
        "-fno-tree-switch-conversion",
        "-Wno-old-style-declaration",
        "-DCHIP_HAVE_CONFIG_H",
        "-Wno-strict-prototypes",
        "-std=gnu17",
        "-w",
    ]

_CXX_COPTS = [
        "-march=rv32imac_zicsr_zifencei",
        "-fno-rtti",
        "-ffunction-sections",
        "-fdata-sections",
        "-Wno-error=unused-function",
        "-Wno-error=unused-variable",
        "-Wno-error=unused-but-set-variable",
        "-Wno-error=deprecated-declarations",
        "-Wno-error=extra",
        "-Wno-unused-parameter",
        "-Wno-sign-compare",
        "-Wno-enum-conversion",
        "-gdwarf-4",
        "-ggdb",
        "-freorder-blocks",
        "-Wwrite-strings",
        "-fstack-protector",
        "-fstrict-volatile-bitfields",
        "-fno-jump-tables",
        "-fno-tree-switch-conversion",
        "-fexceptions",
        "-fuse-cxa-atexit",
        "-DCHIP_HAVE_CONFIG_H",
        "-std=gnu++2b",
        "-w",
    ]

cc_library(
    name = "core_c",
    srcs = glob(["cores/esp32/**/*.c", "variants/esp32c6/**/*.c"], allow_empty = True),
    copts = _C_COPTS,
    # Force all core objects in: the core HAL (.c) and Arduino API (.cpp) call
    # each other, so split archives would drop objects to the wrong link order.
    alwayslink = True,
    deps = [":sdk_hdrs"],
)

cc_library(
    name = "core_cpp",
    srcs = glob(["cores/esp32/**/*.cpp", "variants/esp32c6/**/*.cpp", "libraries/SPI/**/*.cpp"], allow_empty = True),
    copts = _CXX_COPTS,
    alwayslink = True,
    deps = [":sdk_hdrs"],
)

# Bundled Arduino libraries (beyond SPI, which rides along in the core above).
# Each mirrors libraries/<X>/src. Header-only plumbing (esp32-hal, IDF) comes
# from :sdk_hdrs; inter-library deps mirror their #includes.
cc_library(
    name = "network",
    srcs = glob(["libraries/Network/src/**/*.cpp"], allow_empty = True),
    hdrs = glob(["libraries/Network/src/**/*.h"], allow_empty = True),
    includes = ["libraries/Network/src"],
    copts = _CXX_COPTS,
    deps = [":sdk_hdrs"],
)

cc_library(
    name = "fs",
    srcs = glob(["libraries/FS/src/**/*.cpp"], allow_empty = True),
    hdrs = glob(["libraries/FS/src/**/*.h"], allow_empty = True),
    includes = ["libraries/FS/src"],
    copts = _CXX_COPTS,
    deps = [":sdk_hdrs"],
)

cc_library(
    name = "wifi",
    srcs = glob(["libraries/WiFi/src/**/*.cpp"], allow_empty = True),
    hdrs = glob(["libraries/WiFi/src/**/*.h"], allow_empty = True),
    includes = ["libraries/WiFi/src"],
    copts = _CXX_COPTS,
    deps = [
        ":network",
        ":sdk_hdrs",
    ],
)

cc_library(
    name = "hash",
    srcs = glob(["libraries/Hash/src/**/*.cpp"], allow_empty = True),
    hdrs = glob(["libraries/Hash/src/**/*.h"], allow_empty = True),
    includes = ["libraries/Hash/src"],
    copts = _CXX_COPTS,
    deps = [":sdk_hdrs"],
)

cc_library(
    name = "webserver",
    srcs = glob(["libraries/WebServer/src/**/*.cpp"], allow_empty = True),
    hdrs = glob(["libraries/WebServer/src/**/*.h"], allow_empty = True),
    includes = ["libraries/WebServer/src"],
    copts = _CXX_COPTS,
    deps = [
        ":fs",
        ":hash",
        ":network",
        ":sdk_hdrs",
    ],
)

# The linkable core: carries the IDF link recipe (recipe.c.combine + ld_flags).
cc_library(
    name = "core",
    additional_linker_inputs = [
        ":sdk_link_dirs", ":sdk_libs", ":sdk_ld",
        ":ld_flags", ":ld_scripts", ":ld_libs",
    ],
    linkopts = [
        "@$(location :sdk_link_dirs)",
        "@$(location :ld_flags)",
        "@$(location :ld_scripts)",
        "-Wl,--wrap=esp_panic_handler",
        "-Wl,--wrap=esp_bt_mem_release",
        "-Wl,--wrap=esp_bt_controller_mem_release",
        "-Wl,--start-group",
        "@$(location :ld_libs)",
        "-Wl,--end-group",
        "-Wl,-EL",
    ],
    deps = [":core_c", ":core_cpp", ":sdk_hdrs"],
)
