# GENERATED scaffold for @arduino_esp32 (merged core + esp32c6 SDK). Edit as needed.
# Compile: includes/defines as native attrs (propagate to the app); per-language
# std flags. Link: -L dirs computed at build time + the shipped ld_* response
# files, in a --start-group with the SDK archives.
package(default_visibility = ["//visibility:public"])

# -L dirs for lib/, ld/, and the memory-type dir, from real staged paths.
genrule(
    name = "sdk_link_dirs",
    srcs = [
        "sdk/esp32c6/lib/libriscv.a",
        "sdk/esp32c6/ld/memory.ld",
        "sdk/esp32c6/qio_qspi/libspi_flash.a",
    ],
    outs = ["sdk_link_dirs.rsp"],
    cmd = ("echo \"-L$$(dirname $(location sdk/esp32c6/lib/libriscv.a))\" > $@ && " +
           "echo \"-L$$(dirname $(location sdk/esp32c6/ld/memory.ld))\" >> $@ && " +
           "echo \"-L$$(dirname $(location sdk/esp32c6/qio_qspi/libspi_flash.a))\" >> $@"),
)

filegroup(name = "sdk_libs", srcs = glob([
    "sdk/esp32c6/lib/*.a",
    "sdk/esp32c6/qio_qspi/*.a",
    "sdk/esp32c6/ld/*.a",  # libphy.a, libbtbb.a live alongside the ld scripts
]))
filegroup(name = "sdk_ld", srcs = glob(["sdk/esp32c6/ld/*.ld"]))
filegroup(name = "ld_flags", srcs = ["sdk/esp32c6/flags/ld_flags"])
filegroup(name = "ld_scripts", srcs = ["sdk/esp32c6/flags/ld_scripts"])
filegroup(name = "ld_libs", srcs = ["sdk/esp32c6/flags/ld_libs"])

# Prebuilt pieces needed to assemble a bootable flash image (see esptool_flash).
filegroup(name = "bootloader_elf", srcs = ["sdk/esp32c6/bin/bootloader_qio_80m.elf"])

# Generate the partition table from the CSV like the IDE does. The repo's
# shipped tools/partitions/default.bin is stale: old layout and no trailing MD5
# row, which IDF >= 5 partition loading requires (load fails with 0x105).
genrule(
    name = "partitions_default",
    srcs = ["tools/partitions/default.csv"],
    outs = ["partitions_default.bin"],
    cmd = "python3 $(location :gen_esp32part) -q $(location tools/partitions/default.csv) $@",
    tools = [":gen_esp32part"],
)

# Single-app layout (no OTA slots): app0 grows to 0x200000 — for apps that
# outgrow default.csv's 0x140000 slot (WiFi + webserver + FastLED + a
# protocol stack lands around 1.5 MB). Same nvs/otadata/app0 offsets, so
# esptool_flash needs only `partitions = ...` overridden.
genrule(
    name = "partitions_no_ota",
    srcs = ["tools/partitions/no_ota.csv"],
    outs = ["partitions_no_ota.bin"],
    cmd = "python3 $(location :gen_esp32part) -q $(location tools/partitions/no_ota.csv) $@",
    tools = [":gen_esp32part"],
)

filegroup(name = "gen_esp32part", srcs = ["tools/gen_esp32part.py"])

filegroup(name = "boot_app0", srcs = ["tools/partitions/boot_app0.bin"])

# Header + include-path + define carrier (propagates to dependents incl. the app).
cc_library(
    name = "sdk_hdrs",
    hdrs = glob(
        ["sdk/esp32c6/include/**/*.h", "sdk/esp32c6/qio_qspi/include/**/*.h",
         "cores/esp32/**/*.h", "variants/esp32c6/**/*.h", "sdk/esp32c6/include/**/*.hpp",
         "libraries/SPI/**/*.h"],
        allow_empty = True,
    ),
    includes = [
        "sdk/esp32c6/include/newlib/platform_include",
        "sdk/esp32c6/include/freertos/config/include",
        "sdk/esp32c6/include/freertos/config/include/freertos",
