# Board platforms + the constraints that key toolchain resolution and the
# select()s in platform-support code.
#
# We use a custom `board` constraint as the primary discriminator (rather than
# leaning on @platforms//cpu, whose set of embedded CPU values is incomplete for
# Cortex-M33/rv32imac). @platforms//os:none marks bare-metal.
#
# Note the naming: the constraint_values are `*_board` and the platform() targets
# are the bare board names (a constraint_value and a platform can't share a name
# in one package).
package(default_visibility = ["//visibility:public"])

constraint_setting(name = "board")

# Orthogonal to `board`: marks a target as built to run under the Unicorn CPU
# emulator (//rules/sim) rather than on real silicon. It keys the sim
# cc_toolchain and lets sim-only support code (e.g. //rules/sim:sim_rt) gate
# itself with target_compatible_with. A simulation_platform picks the CPU
# architecture (e.g. armv8-m) on top of this.
constraint_setting(name = "runtime_env")

constraint_value(
    name = "sim_unicorn",
    constraint_setting = ":runtime_env",
)

constraint_value(
    name = "rp2350_board",
    constraint_setting = ":board",
)

constraint_value(
    name = "esp32c6_board",
    constraint_setting = ":board",
)

constraint_value(
    name = "esp32_board",
    constraint_setting = ":board",
)

constraint_value(
    name = "stm32g0_board",
    constraint_setting = ":board",
)

constraint_value(
    name = "stm32h7_board",
    constraint_setting = ":board",
)

# RP2350 in Arm Cortex-M33 mode. cpu:armv8-m is exactly the Cortex-M33 profile
# and is what rules_rust maps thumbv8m.main-none-eabihf to, so this single set
# resolves BOTH the cc_toolchain and the Rust toolchain.
platform(
    name = "rp2350",
    constraint_values = [
        "@platforms//cpu:armv8-m",
        "@platforms//os:none",
        ":rp2350_board",
    ],
)

# ESP32-C6 (RISC-V rv32imac). Milestone 2.
platform(
    name = "esp32c6",
    constraint_values = [
        "@platforms//cpu:riscv32",
        "@platforms//os:none",
        ":esp32c6_board",
    ],
)

# Classic ESP32 / ESP32-WROOM (Xtensa LX6, dual core). @platforms//cpu has no
# xtensa value, so the board constraint alone discriminates; that's fine because
# no other registered toolchain matches os:none + esp32_board. (No Rust triple
# either: upstream rustc has no Xtensa backend — Rust-linking apps stay off
# this board.)
platform(
    name = "esp32",
    constraint_values = [
        "@platforms//os:none",
        ":esp32_board",
    ],
)

# STM32G0 family (Arm Cortex-M0+, armv6-m). Bare-metal, no Arduino core — the
# board support ships its own startup + linker script and links against the same
# @arm_gcc arm-none-eabi GCC as the RP2350. cpu:armv6-m is exactly the
# Cortex-M0/M0+ profile, which (with os:none + the board constraint) resolves the
# stm32g0 cc_toolchain. The whole G0 line (G031…G0B1/G0C1) shares this toolchain
# and board support; a specific part differs only in its linker memory map (see
# //libs/board/stm32g0:stm32g0.bzl) and pyOCD flash target. No Rust triple: the
# demo app is pure C/C++.
platform(
    name = "stm32g0",
    constraint_values = [
        "@platforms//cpu:armv6-m",
        "@platforms//os:none",
        ":stm32g0_board",
    ],
)

# STM32H7 (Arm Cortex-M7, armv7e-m). Single-M7-side view of the STM32H757
# (Cube Orange+ autopilot MCU). Bare-metal, no Arduino core — the board support
# ships its own startup + linker script and links against the same @arm_gcc
# arm-none-eabi GCC as the STM32G0/RP2350. cpu:armv7e-m is exactly the
# Cortex-M7 (and M4) profile, and DOES resolve in @platforms (confirmed:
# @platforms//cpu:armv7e-m exists in platforms 1.1.0), so — unlike the esp32
# board-constraint-only case — we key on the real CPU constraint here (with
# os:none + the board constraint) to resolve the stm32h7 cc_toolchain. The
# double-precision FPU (fpv5-d16, hard float ABI) is selected by -mfpu/-mfloat-abi
# in the toolchain, NOT the constraint (mirrors the G0/RP2350 pattern; the
# armv7e-mf "with fpu" constraint is intentionally not used). No Rust triple: the
# benchmark app is pure C.
platform(
    name = "stm32h7",
    constraint_values = [
        "@platforms//cpu:armv7e-m",
        "@platforms//os:none",
        ":stm32h7_board",
    ],
)

# Unicorn simulation target, ARMv8-M (Cortex-M33) profile. cpu:armv8-m is the
# same ISA the RP2350 uses, but the `sim_unicorn` marker (not rp2350_board)
# resolves the dedicated sim cc_toolchain (//toolchains/cc/sim_armv8m) and keeps
# the emulated build independent of any physical board. A simulation_platform of
# architecture "armv8-m" transitions the stub to this platform.
platform(
    name = "sim_armv8m",
    constraint_values = [
        "@platforms//cpu:armv8-m",
        "@platforms//os:none",
        ":sim_unicorn",
    ],
)

# config_settings so libraries can select() on the active board.
config_setting(
    name = "is_rp2350",
    constraint_values = [":rp2350_board"],
)

config_setting(
    name = "is_esp32c6",
    constraint_values = [":esp32c6_board"],
)

config_setting(
    name = "is_esp32",
    constraint_values = [":esp32_board"],
)

config_setting(
    name = "is_stm32g0",
    constraint_values = [":stm32g0_board"],
)

config_setting(
    name = "is_stm32h7",
    constraint_values = [":stm32h7_board"],
)

config_setting(
    name = "is_sim",
    constraint_values = [":sim_unicorn"],
)
