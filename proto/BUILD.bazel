# Protobuf base support for consumers of this module: a prebuilt protoc
# (select()ed per host, no from-source protobuf compile in the dep graph)
# and the micropb no_std runtime + host-side generator. Consumers use the
# macros in micropb.bzl; see that file for the full pattern.

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "linux_aarch64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "osx_aarch64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:osx",
    ],
)

config_setting(
    name = "osx_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:osx",
    ],
)

alias(
    name = "protoc",
    actual = select({
        ":linux_aarch64": "@protoc_linux_aarch64//:bin/protoc",
        ":linux_x86_64": "@protoc_linux_x86_64//:bin/protoc",
        ":osx_aarch64": "@protoc_osx_aarch64//:bin/protoc",
        ":osx_x86_64": "@protoc_osx_x86_64//:bin/protoc",
    }),
)

# no_std protobuf runtime for generated code (firmware + host Rust).
alias(
    name = "micropb",
    actual = "@fw_proto_crates//:micropb",
)

# heapless: the container crate micropb's generated code binds to.
alias(
    name = "heapless",
    actual = "@fw_proto_crates//:heapless",
)

# Host-side generator library (link into a per-project gen_main driver).
alias(
    name = "micropb_gen",
    actual = "@fw_protogen_crates//:micropb-gen",
)
