"""Bazel (bzlmod) module for ESP32-C6 + RP2350 bare-metal firmware.

Toolchains and Arduino core sources are supplied by Nix via rules_nixpkgs; Bazel
does the actual compile/link with native cc_* rules against those inputs. Rust
modules link into the firmware via rules_rust with bare-metal target triples.

Version pins were verified against the Bazel Central Registry on 2026-07-10.
See WORKLOG.md for the post-relaunch bootstrap order and the list of values that
still need to be validated on a Nix-enabled host (FOD hashes, arduino-pico tag).
"""

module(
    name = "firmware",
    version = "0.0.0",
    compatibility_level = 1,
)

# --- Core rule sets (pinned) ------------------------------------------------
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "rules_pkg", version = "1.2.0")
bazel_dep(name = "rules_rust", version = "0.71.3")

# Rust <-> C/C++ interop:
#  - rules_rust_bindgen: generate Rust FFI from C headers (C -> Rust)
#  - cxx.rs: the cxx crate's Bazel rules for safe C++ <-> Rust bridges
# (cbindgen, Rust -> C headers, is a custom rule in //rules:cbindgen.bzl using
#  the Nix `cbindgen` binary.)
bazel_dep(name = "rules_rust_bindgen", version = "0.71.3")
bazel_dep(name = "cxx.rs", version = "1.0.190")  # 1.0.197+ requires Bazel >=8.0

# rules_nixpkgs: only the *core* module is on the BCR. We do NOT use
# rules_nixpkgs_cc — we hand-write our bare-metal cc_toolchains (§toolchains/cc)
# and only borrow the compiler *binaries* + Arduino sources from Nix.
bazel_dep(name = "rules_nixpkgs_core", version = "0.13.0")

# ---------------------------------------------------------------------------
# Nix: one nixpkgs repo, then individual derivations imported as Bazel repos.
# ---------------------------------------------------------------------------
# isolate: the attr/file tags are root-module-only for shared extension
# usages, and this module is consumed as a DEPENDENCY by led_mapper (vendored
# at third_party/embedded). Isolation scopes the repos to this module and
# lifts the restriction; consumers need --experimental_isolated_extension_usages
# (Bazel 7) in their .bazelrc, as this repo's own .bazelrc does.
nix_repo = use_extension(
    "@rules_nixpkgs_core//extensions:repository.bzl",
    "nix_repo",
    isolate = True,
)

# Pinned to a nixos-25.11 commit (branch tarballs 404 on the refs/tags URL that
# `tag=` builds). Keep in sync with flake.nix's nixpkgs input.
nix_repo.github(
    name = "nixpkgs",
    org = "NixOS",
    repo = "nixpkgs",
    commit = "b6018f87da91d19d0ab4cf979885689b469cdd41",
)
use_repo(nix_repo, "nixpkgs")

nix_pkg = use_extension(
    "@rules_nixpkgs_core//extensions:package.bzl",
    "nix_pkg",
    isolate = True,
)

# arm-none-eabi GCC (13.3.rel1, ships newlib-nano's libc_nano) — RP2350.
nix_pkg.attr(
    name = "arm_gcc",
    attr = "gcc-arm-embedded",
    repo = "@nixpkgs",
    build_file = "//nix:arm_gcc.BUILD",
)

# picotool — elf -> uf2 for RP2350.
nix_pkg.attr(
    name = "picotool",
    attr = "picotool",
    repo = "@nixpkgs",
    build_file = "//nix:picotool.BUILD",
)

# arduino-pico core sources + prebuilt libpico.a + linker script, fetched by a
# small Nix derivation (nix/arduino_pico.nix). The generated repo carries the
# cc_library(core) + cc_import(libpico) — see nix/arduino_pico.BUILD.
nix_pkg.file(
    name = "arduino_pico",
    file = "//nix:arduino_pico.nix",
    # arduino_pico.nix does `import ./arduino_pico_drv.nix`, so that file must be
    # brought into the Nix eval context alongside it.
    file_deps = ["//nix:arduino_pico_drv.nix"],
    attr = "arduino-pico",
    repo = "@nixpkgs",
    build_file = "//nix:arduino_pico.BUILD",
)

# cbindgen (Rust -> C/C++ headers) — used by //rules:cbindgen.bzl.
nix_pkg.attr(
    name = "cbindgen",
    attr = "rust-cbindgen",
    repo = "@nixpkgs",
    build_file = "//nix:cbindgen.BUILD",
)

# bindgen toolchain deps (prebuilt from Nix — avoids compiling LLVM from source
# like rules_rust_bindgen's default toolchain does). See //toolchains/bindgen.
nix_pkg.attr(name = "bindgen_tool", attr = "rust-bindgen", repo = "@nixpkgs", build_file = "//nix:bindgen_tool.BUILD")
nix_pkg.attr(name = "clang_tool", attr = "clang", repo = "@nixpkgs", build_file = "//nix:clang.BUILD")
nix_pkg.attr(name = "libclang", attr = "llvmPackages.libclang.lib", repo = "@nixpkgs", build_file = "//nix:libclang.BUILD")

# --- ESP32-C6 (Milestone 2) ------------------------------------------------
# esptool — elf -> flashable .bin.
nix_pkg.attr(
    name = "esptool",
    attr = "esptool",
    repo = "@nixpkgs",
    build_file = "//nix:esptool.BUILD",
)

# Espressif prebuilt riscv32-esp-elf GCC (esp-14.2.0_20260121), fetched +
# autoPatchelf'd by nix/esp_riscv_gcc.nix.
nix_pkg.file(
    name = "riscv_gcc",
    file = "//nix:arduino_esp32.nix",
    file_deps = [
        "//nix:arduino_esp32_drv.nix",
        "//nix:esp32_arduino_libs.nix",
        "//nix:esp_riscv_gcc.nix",
        "//nix:esp_xtensa_gcc.nix",
    ],
    attr = "riscv32-esp-elf",
    repo = "@nixpkgs",
    build_file = "//nix:riscv_gcc.BUILD",
)

# Espressif prebuilt xtensa-esp-elf GCC (same esp-14.2.0_20260121 release) —
# classic ESP32 / ESP32-WROOM (Xtensa LX6). No Rust triple for this one:
# upstream rustc has no Xtensa backend (that needs the esp-rs fork).
nix_pkg.file(
    name = "xtensa_gcc",
    file = "//nix:arduino_esp32.nix",
    file_deps = [
        "//nix:arduino_esp32_drv.nix",
        "//nix:esp32_arduino_libs.nix",
        "//nix:esp_riscv_gcc.nix",
        "//nix:esp_xtensa_gcc.nix",
    ],
    attr = "xtensa-esp-elf",
    repo = "@nixpkgs",
    build_file = "//nix:xtensa_gcc.BUILD",
)

# arduino-esp32 core merged with the per-chip prebuilt SDKs (esp32-arduino-libs)
# into one tree at sdk/<chip> (esp32c6, esp32). Carries the per-chip
# cc_library(core) targets — see arduino_esp32.BUILD.
nix_pkg.file(
    name = "arduino_esp32",
    file = "//nix:arduino_esp32.nix",
    file_deps = [
        "//nix:arduino_esp32_drv.nix",
        "//nix:esp32_arduino_libs.nix",
        "//nix:esp_riscv_gcc.nix",
        "//nix:esp_xtensa_gcc.nix",
    ],
    attr = "arduino-esp32",
    repo = "@nixpkgs",
    build_file = "//nix:arduino_esp32.BUILD",
)

use_repo(
    nix_pkg,
    "arm_gcc",
    "picotool",
    "arduino_pico",
    "cbindgen",
    "bindgen_tool",
    "clang_tool",
    "libclang",
    "esptool",
    "riscv_gcc",
    "xtensa_gcc",
    "arduino_esp32",
)

# ---------------------------------------------------------------------------
# Add-on Arduino libraries via the repo rule (zip -> code-generated BUILD). The
# generated cc_library depends on the board-agnostic core facade, so it compiles
# for whichever board the embedded_binary transition selects.
# ---------------------------------------------------------------------------
arduino = use_extension("//rules:extensions.bzl", "arduino")
arduino.library(
    name = "fastled",
    urls = ["https://github.com/FastLED/FastLED/archive/refs/tags/3.10.5.zip"],
    sha256 = "1d873ce548a9a00aaaf0f8fd9e9c15560fd997f19871810e9889750f6094ae66",
    strip_prefix = "FastLED-3.10.5",
    src_dirs = ["src"],
    defines = ["FASTLED_INTERNAL"],  # silence the version-pragma spam
    deps = ["@firmware//libs/board:arduino_core"],
)
use_repo(arduino, "fastled")

# ---------------------------------------------------------------------------
# Rust: bare-metal target triples for both boards. rules_rust fetches prebuilt
# rust-std (core/alloc) for these tier-2 triples on stable — no -Zbuild-std.
# ---------------------------------------------------------------------------
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = ["1.85.0"],
    extra_target_triples = [
        # RP2350 Cortex-M33. Use the SOFT-float-ABI triple (eabi, not eabihf):
        # arduino-pico builds -mfloat-abi=softfp (VFP instructions, but floats
        # passed in core registers = soft ABI). eabihf is hard-float ABI and the
        # linker refuses to merge it with softfp objects ("uses VFP register
        # arguments"). eabi maps to the same constraints (cpu:armv8-m, os:none).
        "thumbv8m.main-none-eabi",
        "riscv32imac-unknown-none-elf",  # ESP32-C6
    ],
)
use_repo(rust, "rust_toolchains")

register_toolchains(
    "@rust_toolchains//:all",
    # bindgen toolchain backed by Nix prebuilt clang/libclang (the default
    # rules_rust_bindgen toolchain compiles LLVM from source — too heavy).
    "//toolchains/bindgen:bindgen_toolchain",
    "//toolchains/cc/rp2350_arm:cc_toolchain",
    "//toolchains/cc/esp32c6:cc_toolchain",
    "//toolchains/cc/esp32:cc_toolchain",
)

# ---------------------------------------------------------------------------
# Protobuf base support (shared across consumers — led_mapper, the UWB widget
# repo): prebuilt protoc + the micropb no_std runtime + its host-side code
# generator. Everything is ISOLATED so this module works identically as root
# or as a dependency, with zero repo/feature collisions against whatever
# crate universes the consumer defines. See //proto (aliases + macros).
# ---------------------------------------------------------------------------
bazel_dep(name = "toolchains_protoc", version = "0.6.1")
bazel_dep(name = "rules_proto", version = "7.1.0")

protoc = use_extension(
    "@toolchains_protoc//protoc:extensions.bzl",
    "protoc",
    isolate = True,
)
protoc.toolchain(
    google_protobuf = "com_google_protobuf",
    version = "v29.3",
)
use_repo(
    protoc,
    protoc_linux_aarch64 = "toolchains_protoc_hub.linux_aarch_64",
    protoc_linux_x86_64 = "toolchains_protoc_hub.linux_x86_64",
    protoc_osx_aarch64 = "toolchains_protoc_hub.osx_aarch_64",
    protoc_osx_x86_64 = "toolchains_protoc_hub.osx_x86_64",
)

# micropb runtime for firmware/host Rust: no_std, heapless containers.
# 0.5.1 is the newest line whose generator builds on rustc 1.85.0
# (micropb-gen 0.6 needs let-chains, MSRV 1.88) — keep runtime+gen locked.
fw_proto_crate = use_extension(
    "@rules_rust//crate_universe:extensions.bzl",
    "crate",
    isolate = True,
)
fw_proto_crate.spec(
    default_features = False,
    features = [
        "encode",
        "decode",
        "enable-64bit",
        "container-heapless",
    ],
    package = "micropb",
    version = "0.5.1",
)
fw_proto_crate.spec(
    default_features = False,
    package = "heapless",
    version = "0.8",
)
fw_proto_crate.from_specs(
    name = "fw_proto_crates",
    # Non-root crate universes must ship a lockfile (repinning does not work
    # across module boundaries). Repin from THIS repo as root:
    #   CARGO_BAZEL_REPIN=1 bazelisk query @fw_proto_crates//:micropb
    lockfile = "//proto:fw_proto_crates-lock.json",
    cargo_lockfile = "//proto:fw_proto_crates-Cargo.lock",
    # rules_rust's default triple list is host-centric; restate it to EXTEND
    # it with this module's bare-metal triples so @fw_proto_crates//:micropb
    # resolves for the firmware platforms too.
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "wasm32-unknown-unknown",
        "wasm32-wasip1",
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu",
        "thumbv8m.main-none-eabi",
        "riscv32imac-unknown-none-elf",
    ],
)
use_repo(fw_proto_crate, "fw_proto_crates")

# HOST-side micropb code generator (build tool, not a firmware dep). Own
# isolated universe: it needs micropb WITH std, and crate_universe unifies
# features per crate within a universe — sharing one would leak std onto the
# firmware micropb and break the bare-metal builds.
fw_protogen_crate = use_extension(
    "@rules_rust//crate_universe:extensions.bzl",
    "crate",
    isolate = True,
)
fw_protogen_crate.spec(
    package = "micropb-gen",
    version = "0.5.1",
)
fw_protogen_crate.from_specs(
    name = "fw_protogen_crates",
    lockfile = "//proto:fw_protogen_crates-lock.json",
    cargo_lockfile = "//proto:fw_protogen_crates-Cargo.lock",
)
use_repo(fw_protogen_crate, "fw_protogen_crates")
