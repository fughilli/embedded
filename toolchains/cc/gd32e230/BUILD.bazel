# GD32E230 (Arm Cortex-M23, ARMv8-M Baseline) cc_toolchain: our reusable config
# rule + the same Nix arm-none-eabi GCC (@arm_gcc) used by the RP2350/STM32, gated
# to the //platforms:gd32e230 platform. Used to LINK the rd03e-reverse Rust
# firmware (a rust_binary that brings its own vector table + reset handler +
# linker script in-crate — see docs/re). The flags are generic Cortex-M23, so a
# future M23 part can reuse this config by adding its own board-gated toolchain().
load("//toolchains/cc:cc_toolchain_config.bzl", "cc_toolchain_config")

package(default_visibility = ["//visibility:public"])

# Cortex-M23 bare-metal flags. The GD32E230 core is armv8-m baseline with NO FPU,
# so this is a pure soft-float build (-mfloat-abi=soft): no -mfpu, no VFP.
_CORE_ARCH_FLAGS = [
    "-mcpu=cortex-m23",
    "-mthumb",
    "-mfloat-abi=soft",
]

cc_toolchain_config(
    name = "config",
    toolchain_identifier = "gd32e230-arm-none-eabi",
    target_cpu = "cortex-m23",
    target_system_name = "arm-none-eabi",
    gcc = "@arm_gcc//:gcc",
    gpp = "@arm_gcc//:g++",
    ar = "@arm_gcc//:ar",
    strip = "@arm_gcc//:strip",
    # Bare-metal, no core/startfiles: newlib-nano libc/libm, newlib's syscall
    # stubs (nosys.specs), and -nostartfiles because the firmware supplies its own
    # reset vector + vector table (crt0 would fight it). --gc-sections drops the
    # unreferenced newlib startup that nosys still pulls in. Mirrors //toolchains/
    # cc/stm32g0 (Cortex-M0+); only the -mcpu differs.
    compile_flags = _CORE_ARCH_FLAGS + [
        "-ffunction-sections",
        "-fdata-sections",
        "-ffreestanding",
        "-fno-exceptions",
        "-fno-unwind-tables",
        "-no-canonical-prefixes",
    ],
    link_flags = _CORE_ARCH_FLAGS + [
        "--specs=nano.specs",
        "--specs=nosys.specs",
        "-nostartfiles",
        "-Wl,--gc-sections",
        # No -no-canonical-prefixes at link (see the stm32g0 note): canonical
        # (absolute) LTO-plugin prefixes load on both macOS and Linux.
    ],
)

cc_toolchain(
    name = "gd32e230_cc",
    all_files = "@arm_gcc//:all",
    ar_files = "@arm_gcc//:all",
    compiler_files = "@arm_gcc//:all",
    dwp_files = "@arm_gcc//:all",
    linker_files = "@arm_gcc//:all",
    objcopy_files = "@arm_gcc//:all",
    strip_files = "@arm_gcc//:all",
    toolchain_config = ":config",
)

# Registered in MODULE.bazel; resolves when the target platform is gd32e230.
# Board-only match (no cpu constraint) — see //platforms:gd32e230 for why.
toolchain(
    name = "cc_toolchain",
    target_compatible_with = [
        "@platforms//os:none",
        "//platforms:gd32e230_board",
    ],
    toolchain = ":gd32e230_cc",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)
