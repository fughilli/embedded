# Per-board pin configuration. The LED strip data pin is chosen by select();
# NUM_LEDS (strip length) is board-independent and lives in pins.h.
#
# Pins are placeholders — change them to match your wiring:
#   RP2350 (Pico 2): GPIO 2      ESP32-C6: GPIO 8      ESP32 (WROOM): GPIO 4
package(default_visibility = ["//visibility:public"])

cc_library(
    name = "pins",
    hdrs = ["pins.h"],
    defines = select({
        "//platforms:is_rp2350": ["LED_DATA_PIN=2"],
        "//platforms:is_esp32c6": ["LED_DATA_PIN=8"],
        "//platforms:is_esp32": ["LED_DATA_PIN=4"],
    }),
    # Board-only (the select has no default) — skipped by //... off-board; a board
    # transition makes it compatible. See //libs/board for the same pattern.
    target_compatible_with = select({
        "//platforms:is_rp2350": [],
        "//platforms:is_esp32c6": [],
        "//platforms:is_esp32": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)
