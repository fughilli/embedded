# Public aliases for the extension-created vendor repos (@fastled,
# @arduino_esp32). Bazel module extensions scope repo names to THIS module,
# so a consumer module (e.g. led_mapper vendoring this repo as @embedded)
# cannot address @fastled//:fastled directly — it CAN address
# @embedded//libs/vendor:fastled. Apps inside this repo may use either form.
package(default_visibility = ["//visibility:public"])

alias(
    name = "fastled",
    actual = "@fastled//:fastled",
)

# wifi/webserver/ble/preferences select the per-chip Arduino-library variant so a
# build carries only its own chip's IDF include set (the c3 variant is built
# against sdk_hdrs_esp32c3). Without this a c3 image pulled BOTH the c6 and c3
# include lists and overflowed the g++ -> cc1plus argv. Build-only c3 target.
alias(
    name = "wifi",
    actual = select({
        "//platforms:is_esp32c3": "@arduino_esp32//:wifi_esp32c3",
        "//conditions:default": "@arduino_esp32//:wifi",
    }),
)

alias(
    name = "webserver",
    actual = select({
        "//platforms:is_esp32c3": "@arduino_esp32//:webserver_esp32c3",
        "//conditions:default": "@arduino_esp32//:webserver",
    }),
)

alias(
    name = "partitions_no_ota",
    actual = "@arduino_esp32//:partitions_no_ota",
)

alias(
    name = "ble",
    actual = select({
        "//platforms:is_esp32c3": "@arduino_esp32//:ble_esp32c3",
        "//conditions:default": "@arduino_esp32//:ble",
    }),
)

alias(
    name = "preferences",
    actual = select({
        "//platforms:is_esp32c3": "@arduino_esp32//:preferences_esp32c3",
        "//conditions:default": "@arduino_esp32//:preferences",
    }),
)

alias(
    name = "partitions_huge_app",
    actual = "@arduino_esp32//:partitions_huge_app",
)
