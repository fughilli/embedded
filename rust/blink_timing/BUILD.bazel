# no_std Rust static library. Emits CcInfo, so a cc_binary can depend on it
# directly and link it with the board's cc_toolchain. Built for the board's
# Rust triple (thumbv8m.main-none-eabihf on RP2350) via toolchain resolution
# against the target platform.
load("@rules_rust//rust:defs.bzl", "rust_static_library")
load("//rules:cbindgen.bzl", "rust_cbindgen")

package(default_visibility = ["//visibility:public"])

rust_static_library(
    name = "blink_timing",
    srcs = ["src/lib.rs"],
    edition = "2021",
    # Bare-metal no_std: abort on panic so we don't need eh_personality.
    rustc_flags = ["-Cpanic=abort"],
)

# Generate a C header for the crate's `extern "C"` API (Rust -> C). The blink
# apps include this instead of hand-writing the `blink_interval_ms` declaration.
rust_cbindgen(
    name = "blink_timing_h",
    srcs = ["src/lib.rs"],
    out = "blink_timing.h",
    lang = "c",
    config = "cbindgen.toml",  # cpp_compat = true -> extern "C" guards
)

cc_library(
    name = "header",
    hdrs = [":blink_timing_h"],
    # Included as "rust/blink_timing/blink_timing.h" (repo-root -iquote).
)

# C++ stand-in for boards with no upstream Rust target (classic ESP32 is
# Xtensa; rustc's Xtensa backend lives only in the esp-rs fork). Same header,
# same ABI — apps select() this instead of :blink_timing there.
cc_library(
    name = "blink_timing_fallback",
    srcs = ["fallback.cpp"],
    deps = [":header"],
)
