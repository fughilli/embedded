# pyOCD as a hermetic, Bazel-vendored flash/debug driver.
#
# pyocd + its deps come from PyPI via rules_python (@pypi, driven by the
# committed requirements.lock). Its one native C library, libusb, is NOT taken
# from a pip wheel: it is materialized from Nix (@libusb) and injected into
# pyusb by the `nix_libusb` wrapper below. Use //tools/pyocd:pyocd directly
# (`bazel run //tools/pyocd -- list`) or the `pyocd_flash` rule for flash targets
# that lack built-in DFU (e.g. the STM32G0B1).
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("@rules_uv//uv:pip.bzl", "pip_compile")

package(default_visibility = ["//visibility:public"])

# requirements.in -> requirements.lock, resolved by uv in UNIVERSAL mode: one lock
# for every OS, with environment markers (so pyOCD's `hidapi ; platform_system !=
# "Linux"` lands in the lock and the macOS/Windows builds resolve). Fast +
# hermetic — uv is fetched via rules_multitool, no system uv/python needed.
#   regenerate:  bazel run //tools/pyocd:requirements.update
#   verify (CI): bazel test //tools/pyocd:requirements_test
pip_compile(
    name = "requirements",
    requirements_in = "requirements.in",
    requirements_txt = "requirements.lock",
    universal = True,
)

# Stage the Nix libusb shared object under a fixed name next to nix_backend.py,
# so it can resolve it by __file__-relative path in runfiles. The source is the
# real .so (Linux) or .dylib (macOS) selected in //nix:libusb.BUILD; ctypes loads
# either by absolute path regardless of the staged filename's extension.
genrule(
    name = "stage_nix_libs",
    srcs = ["@libusb//:lib"],
    outs = ["_nixlib/libusb-1.0.so.0"],
    cmd = "\n".join([
        "mkdir -p $(RULEDIR)/_nixlib",
        "cp $(location @libusb//:lib) $(RULEDIR)/_nixlib/libusb-1.0.so.0",
    ]),
)

# Wrapper py_library: the Nix libusb (as runfiles) + the shim that makes pyusb
# load it. This is the "binary dep substituted via Nix" target.
py_library(
    name = "nix_libusb",
    srcs = ["nix_backend.py"],
    data = [":stage_nix_libs"],
    imports = ["."],
    deps = ["@pypi//pyusb"],
)

# Vendored CMSIS Device Family Packs (from packs.lock via the cmsis_packs
# extension), passed to pack-aware pyocd subcommands by cmsis_pack_inject.
py_library(
    name = "cmsis_packs",
    srcs = ["cmsis_pack_inject.py"],
    data = ["@cmsis_packs//:all_packs"],
    imports = ["."],
)

py_binary(
    name = "pyocd",
    srcs = ["pyocd_main.py"],
    imports = ["."],
    main = "pyocd_main.py",
    deps = [
        ":cmsis_packs",
        ":nix_libusb",
        "@pypi//pyocd",
    ],
)

# Resolve packs.in -> packs.lock (CMSIS index lookup + download + hash).
#   bazel run //tools/pyocd:update_packs
py_binary(
    name = "update_packs",
    srcs = ["update_packs.py"],
    data = ["packs.in"],
    imports = ["."],
    main = "update_packs.py",
    deps = ["@pypi//cmsis_pack_manager"],
)

# Hardware-free check that pyusb binds the Nix libusb (see verify_backend.py).
#   bazel run //tools/pyocd:verify_backend
py_binary(
    name = "verify_backend",
    srcs = ["verify_backend.py"],
    imports = ["."],
    main = "verify_backend.py",
    deps = [":nix_libusb"],
)
