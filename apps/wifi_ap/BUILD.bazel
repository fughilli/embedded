# WiFi soft-AP + webserver smoke test. ESP32-C6 only — depends on the
# arduino-esp32 WiFi/WebServer libraries directly rather than the
# board-agnostic facade.
load("//rules:firmware.bzl", "firmware_binary")
load("//rules:flash.bzl", "esptool_flash")

package(default_visibility = ["//visibility:public"])

cc_binary(
    name = "wifi_ap",
    srcs = ["wifi_ap.cpp"],
    target_compatible_with = select({
        "//platforms:is_esp32c6": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//libs/board:arduino_core",  # the Arduino core (provides main())
        "@arduino_esp32//:webserver",
        "@arduino_esp32//:wifi",
    ],
)

firmware_binary(name = "esp32c6", binary = ":wifi_ap", board = "esp32c6")

esptool_flash(name = "flash_esp32c6", app = ":esp32c6")
