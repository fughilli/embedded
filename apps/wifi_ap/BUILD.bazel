# WiFi soft-AP + webserver serving a color-picker webapp for the onboard LED.
# ESP32-C6 only — depends on the arduino-esp32 WiFi/WebServer libraries
# directly rather than the board-agnostic facade.
load("//rules:firmware.bzl", "firmware_binary")
load("//rules:flash.bzl", "esptool_flash")
load("//rules:resources.bzl", "c_resource_library")

package(default_visibility = ["//visibility:public"])

# page.html -> page_html[] / page_html_len via codegen (see resources.bzl).
c_resource_library(
    name = "page",
    srcs = ["page.html"],
)

cc_binary(
    name = "wifi_ap",
    srcs = ["wifi_ap.cpp"],
    target_compatible_with = select({
        "//platforms:is_esp32c6": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":page",                     # the embedded webapp page
        "//libs/board:arduino_core",  # the Arduino core (provides main())
        "//libs/pins",                # LED_DATA_PIN for the color picker
        "@arduino_esp32//:webserver",
        "@arduino_esp32//:wifi",
    ],
)

firmware_binary(name = "esp32c6", binary = ":wifi_ap", board = "esp32c6")

esptool_flash(name = "flash_esp32c6", app = ":esp32c6")
