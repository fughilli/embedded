# Bare-metal blink for the STM32G081 (Cortex-M0+). One stm32-only cc_binary;
# firmware_binary retargets it to the board and packages the raw Flash .bin.
#
# Unlike the Arduino apps this is freestanding: it links the board's own startup
# + linker script (//libs/board/stm32g081) instead of an Arduino core, so the
# link needs the script wired in via linkopts + additional_linker_inputs.
load("//rules:firmware.bzl", "firmware_binary")

package(default_visibility = ["//visibility:public"])

cc_binary(
    name = "blink",
    srcs = ["blink.cpp"],
    additional_linker_inputs = ["//libs/board/stm32g081:linker_script"],
    # `-T <script>` selects the STM32G081 memory map; the rest of the bare-metal
    # link flags (-nostartfiles, nano/nosys specs, --gc-sections) come from the
    # stm32g081 cc_toolchain.
    linkopts = [
        "-T$(location //libs/board/stm32g081:linker_script)",
        "-Wl,-Map=blink.map",
    ],
    # Only built via firmware_binary's transition; skipped off the stm32g081
    # platform (it has no Arduino core to fall back to).
    target_compatible_with = ["//platforms:stm32g081_board"],
    deps = ["//libs/board/stm32g081:support"],
)

firmware_binary(name = "stm32g081", binary = ":blink", board = "stm32g081")  # -> stm32g081.bin
