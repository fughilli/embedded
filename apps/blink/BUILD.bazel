# One blink app for both boards. firmware_binary generates the per-board ELF,
# flashable artifact, and `flash` runner; the board core is picked by select()
# (via //libs/board) under each embedded_binary's platform transition.
load("//rules:firmware.bzl", "firmware_binary")

package(default_visibility = ["//visibility:public"])

firmware_binary(
    name = "blink",
    srcs = ["blink.cpp"],
    deps = [
        "//libs/board",  # board support + the Arduino core
        "//rust/blink_timing",
        "//rust/blink_timing:header",
    ],
)
