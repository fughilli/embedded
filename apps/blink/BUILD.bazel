# Blink for all boards. One board-agnostic cc_binary; firmware_binary retargets
# + packages it per board, and the flash rules run the tools.
load("//rules:firmware.bzl", "firmware_binary")
load("//rules:flash.bzl", "esptool_flash", "picotool_flash")
load("//rules/sim:sim.bzl", "simulation_app", "simulation_platform")

package(default_visibility = ["//visibility:public"])

cc_binary(
    name = "blink",
    srcs = ["blink.cpp"],
    # Only built via firmware_binary's transition; skipped off a board platform.
    target_compatible_with = select({
        "//platforms:is_rp2350": [],
        "//platforms:is_esp32c6": [],
        "//platforms:is_esp32": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//libs/board",  # board support + the Arduino core
        "//rust/blink_timing:header",
    ] + select({
        # Classic ESP32 is Xtensa — no upstream Rust target — so it links the
        # C++ fallback with the same header/ABI instead of the Rust crate.
        "//platforms:is_esp32": ["//rust/blink_timing:blink_timing_fallback"],
        "//conditions:default": ["//rust/blink_timing"],
    }),
)

firmware_binary(name = "rp2350", binary = ":blink", board = "rp2350")  # -> rp2350.uf2

firmware_binary(name = "esp32c6", binary = ":blink", board = "esp32c6")  # -> esp32c6.bin

firmware_binary(name = "esp32", binary = ":blink", board = "esp32")  # -> esp32.bin

picotool_flash(name = "flash_rp2350", uf2 = ":rp2350")

esptool_flash(name = "flash_esp32c6", app = ":esp32c6")

esptool_flash(
    name = "flash_esp32",
    app = ":esp32",
    bootloader = "//libs/board:esp32_bootloader_bin",
    bootloader_offset = "0x1000",  # classic ESP32 ROM loads from 0x1000, not 0x0
    chip = "esp32",
)

# --- Full-app emulation: boot the EXACT arduino-pico RP2350 image -----------
# Boots //apps/blink:rp2350 (the same ELF behind the flashed .uf2) from its reset
# vector under Unicorn, with the RP2350 boot "basic set" (SIO/bootrom/clock
# status), through the pico-sdk runtime_init into clock init.
#   bazel test //apps/blink:rp2350_boot_sim
simulation_platform(
    name = "rp2350_sim",
    architecture = "armv8-m",
    memory_map = "sim_rp2350_memory_map.json",
)

simulation_app(
    name = "rp2350_boot_sim",
    checker = "rp2350_boot_checker.py",
    checker_module = "rp2350_boot_checker",
    firmware = ":rp2350",
    max_cycles = 40000000,
    platform = ":rp2350_sim",
    plugins = ["//rules/sim/plugins/rp2350:rp2350_boot"],
    size = "medium",
)
