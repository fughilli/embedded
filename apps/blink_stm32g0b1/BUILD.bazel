# Bare-metal blink for the STM32G0B1 (Cortex-M0+). One stm32-only cc_binary;
# firmware_binary retargets it to the family `stm32g0` board and packages the raw
# Flash .bin. The concrete part shows up in exactly two places: the linker memory
# map (stm32g0_linker_script → G0B1 sizes) and the pyOCD flash target.
#
# Unlike the Arduino apps this is freestanding: it links the board's own startup
# + generated linker script (//libs/board/stm32g0) instead of an Arduino core, so
# the link needs the script wired in via linkopts + additional_linker_inputs.
load("//libs/board/stm32g0:stm32g0.bzl", "STM32G0_VARIANTS", "stm32g0_linker_script")
load("//rules:firmware.bzl", "firmware_binary")
load("//rules:flash.bzl", "pyocd_flash")
load("//rules/sim:sim.bzl", "sim_peripheral_plugin", "simulation_app", "simulation_platform")

package(default_visibility = ["//visibility:public"])

_G0B1 = STM32G0_VARIANTS["stm32g0b1"]

# NUCLEO-G0B1RE memory map (512K Flash / 144K SRAM). For another suffix/part,
# swap in a different STM32G0_VARIANTS entry or explicit flash_k/ram_k.
stm32g0_linker_script(
    name = "g0b1_ld",
    flash_k = _G0B1.flash_k,
    ram_k = _G0B1.ram_k,
)

cc_binary(
    name = "blink",
    srcs = ["blink.cpp"],
    additional_linker_inputs = [":g0b1_ld"],
    # `-T <script>` selects the G0B1 memory map; the rest of the bare-metal link
    # flags (-nostartfiles, nano/nosys specs, --gc-sections) come from the stm32g0
    # cc_toolchain.
    linkopts = [
        "-T$(location :g0b1_ld)",
        "-Wl,-Map=blink.map",
    ],
    # Only built via firmware_binary's transition; skipped off the stm32g0
    # platform (it has no Arduino core to fall back to).
    target_compatible_with = ["//platforms:stm32g0_board"],
    deps = ["//libs/board/stm32g0:support"],
)

firmware_binary(name = "stm32g0b1", binary = ":blink", board = "stm32g0")  # -> stm32g0b1.bin

# Flash over SWD via pyOCD (the STM32G0 has no built-in USB DFU). Needs a
# CMSIS-DAP or ST-Link probe. The stm32g0b1 target lives in a CMSIS pack; install
# it once with `bazel run //tools/pyocd -- pack install stm32g0b1`.
#   bazel run //apps/blink_stm32g0b1:flash_stm32g0b1
#   bazel run //apps/blink_stm32g0b1:flash_stm32g0b1 -- --probe <uid>
pyocd_flash(
    name = "flash_stm32g0b1",
    firmware = ":stm32g0b1",
    target = _G0B1.pyocd_target,
)

# --- Full-app emulation MVP -------------------------------------------------
# Boot the EXACT stm32g0b1 image (the same ELF behind the flashed .bin) from its
# reset vector under Unicorn, with virtual RCC+GPIO peripherals, and assert PD8
# actually blinks.  bazel test //apps/blink_stm32g0b1:blink_sim
simulation_platform(
    name = "g0b1_sim",
    architecture = "armv6-m",
    memory_map = "sim_memory_map.json",
)

# App-local plugin (stands in for a client repo extending the device model):
# watches RCC to confirm the GPIOD clock is enabled.
sim_peripheral_plugin(
    name = "blink_rcc_probe",
    srcs = ["blink_rcc_probe.py"],
)

# Device model = the shared STM32G0 GPIO plugin + this app's RCC probe.
simulation_app(
    name = "blink_sim",
    checker = "blink_checker.py",
    checker_module = "blink_checker",
    firmware = ":stm32g0b1",
    max_cycles = 80000000,
    platform = ":g0b1_sim",
    plugins = [
        "//rules/sim/plugins/stm32g0:stm32g0_gpio",
        ":blink_rcc_probe",
    ],
    size = "small",
)
