# ESP32-C6 blink firmware: cc_binary (.elf) -> embedded_binary (transition to
# the board) -> genrule (esptool: .elf -> app .bin) -> flash (esptool write-flash).
load("//rules:embedded.bzl", "embedded_binary")
load("//rules:flash.bzl", "esptool_flash")

package(default_visibility = ["//visibility:public"])

cc_binary(
    name = "blink_elf",
    srcs = ["blink.cpp"],
    deps = [
        "//libs/board",
        "//rust/blink_timing",
        "//rust/blink_timing:header",
        "@arduino_esp32//:core",
    ],
)

embedded_binary(
    name = "blink",
    binary = ":blink_elf",
    platform = "//platforms:esp32c6",
)

# elf -> flashable app .bin (recipe.objcopy.bin). esptool comes from Nix.
genrule(
    name = "blink_bin",
    srcs = [":blink"],
    outs = ["blink.bin"],
    cmd = ("$(execpath @esptool//:bin) --chip esp32c6 elf2image " +
           "--flash_mode qio --flash_freq 80m --flash_size 4MB " +
           "-o $@ $(location :blink)"),
    tools = [
        "@esptool//:bin",
        "@esptool//:all",
    ],
)

# The SDK ships the bootloader as an ELF; convert to a flashable .bin.
genrule(
    name = "bootloader_bin",
    srcs = ["@arduino_esp32//:bootloader_elf"],
    outs = ["bootloader.bin"],
    cmd = ("$(execpath @esptool//:bin) --chip esp32c6 elf2image " +
           "--flash_mode qio --flash_freq 80m --flash_size 4MB " +
           "-o $@ $(location @arduino_esp32//:bootloader_elf)"),
    tools = ["@esptool//:bin", "@esptool//:all"],
)

# `bazel run //apps/blink_esp32c6:flash [-- --port /dev/ttyACM0]`
# Writes a full bootable image (bootloader + partitions + boot_app0 + app).
esptool_flash(
    name = "flash",
    chip = "esp32c6",
    app = ":blink_bin",
    bootloader = ":bootloader_bin",
    partitions = "@arduino_esp32//:partitions_default",
    boot_app0 = "@arduino_esp32//:boot_app0",
)
